{
  "name": "@kevinzonda/design",
  "version": "0.1.0",
  "description": "React components based on GOV.UK Frontend 6.5.1.",
  "type": "module",
  "files": [
    "dist-lib",
    "EXTRA_COMPONENTS.md"
  ],
  "main": "./dist-lib/index.js",
  "module": "./dist-lib/index.js",
  "types": "./dist-lib/index.d.ts",
  "style": "./dist-lib/style.css",
  "exports": {
    ".": {
      "types": "./dist-lib/index.d.ts",
      "import": "./dist-lib/index.js"
    },
    "./components": {
      "types": "./dist-lib/components/index.d.ts",
      "import": "./dist-lib/components.js"
    },
    "./extraComponents": {
      "types": "./dist-lib/extraComponents/index.d.ts",
      "import": "./dist-lib/extraComponents.js"
    },
    "./style.css": "./dist-lib/style.css"
  },
  "publishConfig": { "access": "public" },
  "scripts": {
    "build": "vite build --config vite.lib.config.ts && tsc -p tsconfig.lib.json",
    "lint": "oxlint src"
  },
  "dependencies": {
    "govuk-frontend": "6.5.1"
  },
  "peerDependencies": {
    "react": ">=18.2.0",
    "react-dom": ">=18.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sass": "1.104.1",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
